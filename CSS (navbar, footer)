
/*navegation bar*/	
.navbar{
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 15px 60px;
	background-color: #FFFFFF;
	width: 100%;
	border-bottom: 2px solid #E6DFD1;
	box-shadow:0 px 4px 20px rgba(33, 37, 41, 0.04);
	top: 0;
	z-index:1000;
	box-sizing:border-box;
	font-family: "Isometra", serif;
	}
.logo img{
	width: 130px;
	height: auto;
	display: block;
	}
.menu-checkbox{
	display:none;
	}
.menu-btn{
	display:none;
	font-size:28px;
	cursor:pointer;
	color:#212529;
	}	
.nav-links{
	display: flex;
	gap: 35px;
	list-style: none;
	margin:0;
	padding:0;
	}
.nav-links li{
	position: relative;
	}
.nav-links a{
	text-decoration: none;
	color: #212529;
	font-size: 16px;
	font-weight: bold;
	transition: color 0.2s ease;
	display:block;
	}
.nav-links a:hover,.nav-links a.active{
	color: #FF5722;
	}
.dropdown-content {
	display:none;
	position:absolute;
	top:100%;
	left:0;
	margin:0;
	box-sizing:border-box;
	border: 1px solid #E6DFD1;
	border-radius: 4px;
	background-color: #FFFFFF;
	list-style: none;
	padding:8px 0;
	min-width:200px;
	box-shadow:0 8px 20px rgba(33, 37, 41, 0.08);
	}
.dropdown-content a {
	padding:10px 20px;
	font-size: 14px;
	white-space: nowrap;
	color:#212529;
	font-weight:normal;
	}
.dropdown-content a:hover {
	background-color:#FFF5F2;
	color:#FF5722;
	}
.dropdown-content li {
	width:100%;
	}
.dropdown:hover .dropdown-content {
	display:block;
	}
@media (max-width:768px) {
	.navbar {
	flex-wrap:wrap;
	padding:15px 20px;
	}
	.menu-btn {
	display:block;
	}
	.nav-links {
	display:none;
	width:100%;
	flex-direction:row;
	flex-wrap:wrap;
	justify-content:center;
	gap:15px;
	margin-top:15px;
	padding-top:15px;
	border-top:1px solid #E6DFD1;
	}
	.menu-checkbox:checked ~ .nav-links {
	display:flex;
	}
}

/*footer*/
footer{
	width: 100%;
	background-color: #FFFFFF;
	color: #212529;
	padding:45px 50px 20px 50px;
	margin-top: auto;
	border-top: 2px solid #E6DFD1;
	}
.footer-container{
	display: flex;
	justify-content: space-between;
	flex-wrap: wrap;
	gap:30px;
	max-width: 1100px;
	margin: 0 auto;
	}
.footer-column{
	flex: 1;
	min-width: 220px;
	}
.footer-brand{
	font-family: "Isometra", serif;
	color: #FF5722;
	font-size: 24px;
	margin-bottom: 10px;
	}
.footer-column h4{
	font-family: "Isometra", serif;
	color: #FF5722;
	font-size: 18px;
	margin-bottom: 12px;
	}
.footer-column p{
	font-size: 14px;
	line-height: 1.6;
	color: #6C757D;
	}
.footer-links{
	list-style: none;
	padding: 0;
	}
.footer-links li{
	margin-bottom: 8px;
	}
.footer-links a{
	color: #6C757D;
	text-decoration: none;
	font-size: 14px;
	transition: color 0.2s;
	}
.footer-links a:hover{
	color: #FF5722;
	}
.footer-divider{
	border: none;
	height: 1px;
	background-color: #E6DFD1;
	margin: 3opx auto 20px auto;
	max-width:1100px;
	}
.footer-bottom{
	max-width: 1100px;
	margin: 0 auto;
	display: flex;
	justify-content: space-between;
	align-items: center;
	flex-wrap: wrap;
	gap:15px;
	}
.footer-bottom p{
	font-size: 13px;
	color: #6C757D;
	}
.audio-wrapper audio{
	height: 30px;
	}
